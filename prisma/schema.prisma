generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TECHNICIAN
}

enum OrderServiceType {
  INSTALLATION
  REVIEW
  UNINSTALLATION
  FAILED_APPOINTMENT
  FUEL_SENSOR
  EQUIPMENT_REPLACEMENT
}

enum EquipmentSource {
  SHEETS
  DB
}

enum InventoryEquipmentState {
  AVAILABLE
  INSTALLED
}

enum OrderStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  REQUIRES_CORRECTION
  COMPLETED
  FAILED_APPOINTMENT
  CANCELLED
}

enum FailedAppointmentResolution {
  CANCELLED
  RESCHEDULED
}

enum UnitStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ChecklistCategory {
  DASHBOARD
  WINDOWS
  ACCESSORIES
  TRIMS
  BODYWORK
}

enum ChecklistCondition {
  GOOD
  BAD
  NOT_APPLICABLE
}

enum EquipmentVerificationStatus {
  PENDING
  MATCHED
  DISCREPANCY_REPORTED
}

enum UploadStatus {
  PENDING
  COMPLETED
  REJECTED
  DELETED
}

enum SyncStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
  SUPERSEDED
}

enum ReportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model User {
  id                         String                  @id @default(uuid()) @db.Uuid
  email                      String                  @unique
  passwordHash               String
  name                       String
  role                       UserRole
  technicianId               String?                 @unique @db.Uuid
  active                     Boolean                 @default(true)
  createdAt                  DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                @updatedAt @db.Timestamptz(3)
  technician                 Technician?             @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  registeredEquipment        Equipment[]
  createdOrders              Order[]                 @relation("OrderCreator")
  verifiedEquipment          OrderEquipment[]        @relation("EquipmentVerifier")
  completedChecks            Checklist[]             @relation("ChecklistCompleter")
  uploadedEvidence           Evidence[]              @relation("EvidenceUploader")
  capturedSignatures         Signature[]             @relation("SignatureCapturer")
  reportedDiscrepancies      Discrepancy[]           @relation("DiscrepancyReporter")
  resolvedDiscrepancies      Discrepancy[]           @relation("DiscrepancyResolver")
  refreshSessions            RefreshSession[]
  auditLogs                  AuditLog[]              @relation("AuditActor")
  resolvedFailedAppointments Order[]                 @relation("FailedAppointmentResolver")
  sharedTechnicianAccess     SharedTechnicianAccess?

  @@index([role, active])
}

model Technician {
  id                    String   @id @default(uuid()) @db.Uuid
  externalKey           String?  @unique
  name                  String
  workshop              String?
  legalName             String?
  phone                 String?
  email                 String?
  address               String?
  city                  String?
  state                 String?
  invoice               String?
  taxData               String?
  taxAddress            String?
  departureCost         Decimal? @db.Decimal(10, 2)
  replacementRate       Decimal? @db.Decimal(10, 2)
  installationRate      Decimal? @db.Decimal(10, 2)
  reviewRate            Decimal? @db.Decimal(10, 2)
  uninstallationRate    Decimal? @db.Decimal(10, 2)
  failedAppointmentRate Decimal? @db.Decimal(10, 2)
  fuelSensorRate        Decimal? @db.Decimal(10, 2)
  notes                 String?
  active                Boolean  @default(true)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
  user                  User?
  orders                Order[]

  @@index([active, name])
  @@index([externalKey])
}

model Order {
  id                                String                       @id @default(uuid()) @db.Uuid
  folio                             String                       @unique
  serviceType                       OrderServiceType
  status                            OrderStatus                  @default(DRAFT)
  clientSheetId                     String
  clientNameSnapshot                String
  technicianId                      String?                      @db.Uuid
  technicianNameSnapshot            String?
  technicianExternalKeySnapshot     String?
  pricingUnitRate                   Decimal?                     @db.Decimal(10, 2)
  pricingAppliedQuantity            Int?
  pricingBaseCost                   Decimal?                     @db.Decimal(10, 2)
  pricingDepartureCost              Decimal?                     @db.Decimal(10, 2)
  pricingTravelExpenses             Decimal?                     @db.Decimal(10, 2)
  pricingTotal                      Decimal?                     @db.Decimal(10, 2)
  pricingCurrency                   String?                      @default("MXN")
  pricingSnapshotAt                 DateTime?                    @db.Timestamptz(3)
  pricingVersion                    Int?                         @default(1)
  pricingBreakdown                  Json?                        @db.JsonB
  pricingOverrides                  Json?                        @db.JsonB
  scheduledAt                       DateTime                     @db.Timestamptz(3)
  isHomeService                     Boolean                      @default(false)
  serviceAddress                    String?
  generalNotes                      String?
  failedReason                      String?
  failedAppointmentResolution       FailedAppointmentResolution?
  failedAppointmentResolvedAt       DateTime?                    @db.Timestamptz(3)
  failedAppointmentResolvedById     String?                      @db.Uuid
  failedAppointmentResolutionReason String?
  rescheduledFromOrderId            String?                      @unique @db.Uuid
  correctionReason                  String?
  version                           Int                          @default(1)
  createdById                       String                       @db.Uuid
  startedAt                         DateTime?                    @db.Timestamptz(3)
  completedAt                       DateTime?                    @db.Timestamptz(3)
  cancelledAt                       DateTime?                    @db.Timestamptz(3)
  createdAt                         DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                         DateTime                     @updatedAt @db.Timestamptz(3)
  technician                        Technician?                  @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  createdBy                         User                         @relation("OrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  failedAppointmentResolvedBy       User?                        @relation("FailedAppointmentResolver", fields: [failedAppointmentResolvedById], references: [id], onDelete: SetNull)
  rescheduledFrom                   Order?                       @relation("OrderReschedule", fields: [rescheduledFromOrderId], references: [id], onDelete: Restrict)
  rescheduledOrder                  Order?                       @relation("OrderReschedule")
  inventoryReservations             Equipment[]                  @relation("EquipmentReservation")
  units                             OrderUnit[]
  signature                         Signature?
  driveSignatureUploads             DriveSignatureUpload[]
  discrepancies                     Discrepancy[]
  syncOperations                    SheetSyncOperation[]
  reports                           ServiceOrderReport[]
  sharedTechnicianAccess            SharedTechnicianAccess?

  @@index([technicianId, status, scheduledAt])
  @@index([clientSheetId, createdAt])
  @@index([status, scheduledAt])
  @@index([status, failedAppointmentResolution])
  @@index([failedAppointmentResolvedById])
}

model ServiceOrderReport {
  id            String       @id @default(uuid()) @db.Uuid
  orderId       String       @db.Uuid
  version       Int
  status        ReportStatus @default(PENDING)
  objectKey     String?      @unique
  mimeType      String       @default("application/pdf")
  sizeBytes     Int?
  checksum      String?
  failureReason String?
  generatedAt   DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, version])
  @@index([orderId, status, createdAt])
  @@index([status, createdAt])
}

model DriveFolder {
  logicalKey        String   @id
  driveFileId       String   @unique
  parentDriveFileId String
  name              String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  @@index([parentDriveFileId])
}

model OrderUnit {
  id            String           @id @default(uuid()) @db.Uuid
  orderId       String           @db.Uuid
  label         String
  makeModel     String
  year          Int?
  serialNumber  String
  serviceType   OrderServiceType @default(INSTALLATION)
  status        UnitStatus       @default(PENDING)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  equipment     OrderEquipment[]
  checklist     Checklist?
  evidence      Evidence[]
  discrepancies Discrepancy[]

  @@unique([orderId, serialNumber])
  @@index([orderId, status])
  @@index([orderId, serviceType])
}

model Equipment {
  id                   String                  @id @default(uuid()) @db.Uuid
  imei                 String                  @unique
  brand                String
  model                String
  state                InventoryEquipmentState
  currentClientSheetId String?
  currentClientName    String?
  unitLabel            String?
  unitMakeModel        String?
  unitSerialNumber     String?
  unitYear             Int?
  registrationKey      String                  @unique @db.Uuid
  registrationHash     String
  createdById          String                  @db.Uuid
  reservedOrderId      String?                 @db.Uuid
  version              Int                     @default(1)
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(3)
  createdBy            User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  reservedOrder        Order?                  @relation("EquipmentReservation", fields: [reservedOrderId], references: [id], onDelete: Restrict)
  snapshots            OrderEquipment[]

  @@index([state, currentClientSheetId])
  @@index([reservedOrderId])
}

model OrderEquipment {
  id                         String                      @id @default(uuid()) @db.Uuid
  source                     EquipmentSource             @default(SHEETS)
  inventoryEquipmentId       String?                     @db.Uuid
  inventoryEquipment         Equipment?                  @relation(fields: [inventoryEquipmentId], references: [id], onDelete: Restrict)
  orderUnitId                String                      @db.Uuid
  sheetName                  String                      @default("SALIDAS")
  sheetRowHint               Int?
  externalId                 String?
  imei                       String?
  externalKey                String
  activeAssignment           Boolean                     @default(false)
  brandSnapshot              String?
  modelSnapshot              String?
  lineSnapshot               String?
  iccidSnapshot              String?
  carrierSnapshot            String?
  equipmentConditionSnapshot String?
  serviceStatusSnapshot      String?
  rawSnapshot                Json                        @db.JsonB
  verificationStatus         EquipmentVerificationStatus @default(PENDING)
  verifiedAt                 DateTime?                   @db.Timestamptz(3)
  verifiedById               String?                     @db.Uuid
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(3)
  orderUnit                  OrderUnit                   @relation(fields: [orderUnitId], references: [id], onDelete: Cascade)
  verifiedBy                 User?                       @relation("EquipmentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  discrepancies              Discrepancy[]

  @@unique([orderUnitId, externalKey])
  @@index([externalKey])
  @@index([verifiedById])
}

model Checklist {
  id            String          @id @default(uuid()) @db.Uuid
  orderUnitId   String          @unique @db.Uuid
  completedById String?         @db.Uuid
  completedAt   DateTime?       @db.Timestamptz(3)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  orderUnit     OrderUnit       @relation(fields: [orderUnitId], references: [id], onDelete: Cascade)
  completedBy   User?           @relation("ChecklistCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  items         ChecklistItem[]

  @@index([completedById])
}

model ChecklistItem {
  id          String              @id @default(uuid()) @db.Uuid
  checklistId String              @db.Uuid
  category    ChecklistCategory
  condition   ChecklistCondition?
  notes       String?
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  checklist   Checklist           @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@unique([checklistId, category])
  @@index([checklistId])
}

model Evidence {
  id             String       @id @default(uuid()) @db.Uuid
  orderUnitId    String       @db.Uuid
  objectKey      String       @unique
  idempotencyKey String?      @unique @db.Uuid
  mimeType       String
  sizeBytes      Int
  checksum       String?
  width          Int?
  height         Int?
  status         UploadStatus @default(PENDING)
  uploadedById   String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?    @db.Timestamptz(3)
  deletedAt      DateTime?    @db.Timestamptz(3)
  orderUnit      OrderUnit    @relation(fields: [orderUnitId], references: [id], onDelete: Cascade)
  uploadedBy     User         @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([orderUnitId, status])
  @@index([uploadedById])
  @@index([status, createdAt])
}

model Signature {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @unique @db.Uuid
  signerName   String
  objectKey    String   @unique
  mimeType     String
  sizeBytes    Int
  signedAt     DateTime @db.Timestamptz(3)
  capturedById String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  capturedBy   User     @relation("SignatureCapturer", fields: [capturedById], references: [id], onDelete: Restrict)

  @@index([capturedById])
}

model DriveSignatureUpload {
  idempotencyKey    String    @id @db.Uuid
  orderId           String    @db.Uuid
  actorUserId       String    @db.Uuid
  objectKey         String    @unique
  signerName        String
  checksum          String
  sizeBytes         Int
  previousObjectKey String?
  completedAt       DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Discrepancy {
  id               String          @id @default(uuid()) @db.Uuid
  orderId          String          @db.Uuid
  orderUnitId      String          @db.Uuid
  orderEquipmentId String?         @db.Uuid
  type             String
  description      String
  expectedSnapshot Json            @db.JsonB
  observedSnapshot Json            @db.JsonB
  reportedById     String          @db.Uuid
  reportedAt       DateTime        @default(now()) @db.Timestamptz(3)
  resolvedAt       DateTime?       @db.Timestamptz(3)
  resolvedById     String?         @db.Uuid
  resolutionNotes  String?
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderUnit        OrderUnit       @relation(fields: [orderUnitId], references: [id], onDelete: Cascade)
  orderEquipment   OrderEquipment? @relation(fields: [orderEquipmentId], references: [id], onDelete: SetNull)
  reportedBy       User            @relation("DiscrepancyReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  resolvedBy       User?           @relation("DiscrepancyResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([orderId, resolvedAt])
  @@index([orderUnitId])
  @@index([orderEquipmentId])
  @@index([reportedById])
  @@index([resolvedById])
}

model RefreshSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  jti           String    @unique @db.Uuid
  tokenHash     String
  userAgent     String?
  ipAddress     String?   @db.Inet
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  replacedByJti String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  before      Json?    @db.JsonB
  after       Json?    @db.JsonB
  context     Json?    @db.JsonB
  requestId   String?
  ipAddress   String?  @db.Inet
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([requestId])
}

model SharedTechnicianAccess {
  id        Int      @id
  userId    String?  @unique @db.Uuid
  orderId   String?  @unique @db.Uuid
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Restrict)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([userId, orderId])
}

model SheetSyncOperation {
  id               String     @id @default(uuid()) @db.Uuid
  orderId          String?    @db.Uuid
  operationType    String
  idempotencyKey   String     @unique
  payload          Json       @db.JsonB
  status           SyncStatus @default(PENDING)
  attempts         Int        @default(0)
  lastErrorCode    String?
  lastErrorMessage String?
  scheduledFor     DateTime?  @db.Timestamptz(3)
  nextAttemptAt    DateTime?  @db.Timestamptz(3)
  lastAttemptAt    DateTime?  @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)
  syncedAt         DateTime?  @db.Timestamptz(3)
  order            Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([status, nextAttemptAt, createdAt])
  @@index([operationType, status, scheduledFor])
}

model TechnicalReportSyncSchedule {
  id            String   @id
  syncWeekday   Int      @default(3)
  syncTime      String   @default("17:00")
  cutoffWeekday Int      @default(2)
  timeZone      String   @default("America/Hermosillo")
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
}
