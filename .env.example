NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
TRUST_PROXY=false

DATABASE_URL=postgresql://puk:development-only@localhost:5432/puk?schema=public
DIRECT_URL=postgresql://puk:development-only@localhost:5432/puk?schema=public

# Optional: database integration tests only. Use an isolated local database named puk_test.
# Tests skip this database unless the host is loopback and the database path is exactly /puk_test.
# Never point this variable at development, staging, or production data.
# TEST_DATABASE_URL=postgresql://puk:development-only@localhost:5432/puk_test?schema=public

JWT_ACCESS_PRIVATE_KEY=development-only-replace-with-access-private-key
JWT_ACCESS_PUBLIC_KEY=development-only-replace-with-access-public-key
JWT_REFRESH_PRIVATE_KEY=development-only-replace-with-refresh-private-key
JWT_REFRESH_PUBLIC_KEY=development-only-replace-with-refresh-public-key
JWT_ISSUER=puk-api
JWT_AUDIENCE=puk-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

GOOGLE_SPREADSHEET_ID=development-only-replace-with-spreadsheet-id
GOOGLE_CLIENT_EMAIL=service-account@example.invalid
# Optional in local development; required in production. Configure a dedicated Drive identity
# to enable evidence, signatures, and report files.
# GOOGLE_DRIVE_CLIENT_EMAIL=drive-service@example.invalid
# GOOGLE_DRIVE_PRIVATE_KEY=...
# GOOGLE_DRIVE_SHARED_DRIVE_ID=...
GOOGLE_PRIVATE_KEY=development-only-replace-with-google-private-key
GOOGLE_CLIENTS_SHEET=Clientes
GOOGLE_EQUIPMENT_SHEET=SALIDAS
GOOGLE_TECHNICIANS_SPREADSHEET_ID=development-only-replace-with-technicians-spreadsheet-id
GOOGLE_TECHNICIANS_SHEET_NAME=DIRECTORIO TECNICO
GOOGLE_TECHNICIAN_REPORT_SHEET_NAME=2026

# Optional manual report-email delivery; configure Workspace domain-wide delegation first.
# Use the service-account email and private key from the same Google Cloud JSON credentials.
# GOOGLE_GMAIL_CLIENT_EMAIL=gmail-service@example.invalid
# GOOGLE_GMAIL_PRIVATE_KEY=...
# GOOGLE_GMAIL_SENDER_EMAIL=reports@example.invalid

MAX_EVIDENCE_BYTES=10485760
MAX_SIGNATURE_BYTES=1048576
MIN_PASSWORD_LENGTH=12
CATALOG_CACHE_TTL_SECONDS=60

LOG_LEVEL=debug
SHEETS_TIMEOUT_MS=5000
TECHNICAL_REPORT_CUTOFF_WEEKDAY=2
TECHNICAL_REPORT_SYNC_TIME=17:00
TECHNICAL_REPORT_SYNC_TIMEZONE=America/Hermosillo
TECHNICAL_REPORT_SYNC_WEEKDAY=3
SHEETS_RETRY_LIMIT=3
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
OUTBOX_POLL_INTERVAL_MS=5000

POSTGRES_DB=puk
POSTGRES_USER=puk
POSTGRES_PASSWORD=development-only
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_TECHNICIAN_EMAIL=technician@example.invalid
SEED_ADMIN_PASSWORD=development-only-change-me

VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_DEV_PORT=5173
