NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3000
TRUST_PROXY=false

DATABASE_URL=postgresql://puk:development-only@localhost:5432/puk?schema=public
DIRECT_URL=postgresql://puk:development-only@localhost:5432/puk?schema=public

JWT_ACCESS_PRIVATE_KEY=development-only-replace-with-access-private-key
JWT_ACCESS_PUBLIC_KEY=development-only-replace-with-access-public-key
JWT_REFRESH_PRIVATE_KEY=development-only-replace-with-refresh-private-key
JWT_REFRESH_PUBLIC_KEY=development-only-replace-with-refresh-public-key
JWT_ISSUER=puk-api
JWT_AUDIENCE=puk-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=service-orders
S3_ACCESS_KEY_ID=puk-development
S3_SECRET_ACCESS_KEY=development-only-change-me
S3_FORCE_PATH_STYLE=true

GOOGLE_SPREADSHEET_ID=development-only-replace-with-spreadsheet-id
GOOGLE_CLIENT_EMAIL=service-account@example.invalid
GOOGLE_PRIVATE_KEY=development-only-replace-with-google-private-key
GOOGLE_CLIENTS_SHEET=Clientes
GOOGLE_EQUIPMENT_SHEET=SALIDAS

MAX_EVIDENCE_BYTES=10485760
MAX_SIGNATURE_BYTES=1048576
MIN_PASSWORD_LENGTH=12
PRESIGNED_URL_TTL_SECONDS=300
CATALOG_CACHE_TTL_SECONDS=60

LOG_LEVEL=debug
SHEETS_TIMEOUT_MS=5000
SHEETS_RETRY_LIMIT=3
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
OUTBOX_POLL_INTERVAL_MS=5000

POSTGRES_DB=puk
POSTGRES_USER=puk
POSTGRES_PASSWORD=development-only
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_TECHNICIAN_EMAIL=technician@example.invalid
SEED_ADMIN_PASSWORD=development-only-change-me
MINIO_ROOT_USER=puk-development
MINIO_ROOT_PASSWORD=development-only-change-me

VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:3000
VITE_DEV_PORT=5173
