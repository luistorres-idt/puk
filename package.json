{
  "name": "@puk/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <27",
    "pnpm": ">=11.0.0 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @puk/contracts build && pnpm --parallel --filter @puk/api --filter @puk/web dev",
    "docs:build": "pnpm --filter @puk/api docs:build",
    "docs:validate": "pnpm --filter @puk/api docs:validate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:bootstrap": "pnpm --filter @puk/infra bootstrap",
    "infra:configure": "node infra/scripts/configure-staging-secrets.mjs",
    "infra:deploy": "pnpm --filter @puk/infra run deploy",
    "infra:diff": "pnpm --filter @puk/infra diff",
    "infra:foundation": "pnpm --filter @puk/infra run deploy:foundation",
    "infra:synth": "pnpm --filter @puk/infra synth",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:validate": "prisma validate",
    "test": "pnpm --filter @puk/contracts build && pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @puk/web test:e2e",
    "test:e2e:mock": "bash infra/scripts/e2e-test.sh --mock",
    "test:e2e:opaque": "bash infra/scripts/e2e-test.sh",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@puk/eslint-config": "workspace:*",
    "dotenv": "^17.2.3",
    "eslint": "^10.0.0",
    "prettier": "^3.6.2",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
