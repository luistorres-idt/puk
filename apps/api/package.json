{
  "name": "@puk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./dist/app.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "docs:build": "pnpm build && node dist/docs/build-openapi.js",
    "docs:validate": "pnpm build && node dist/docs/validate-openapi.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@puk/contracts": "workspace:*",
    "@valibot/to-json-schema": "^1.7.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "googleapis": "^178.0.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "morgan": "^1.12.0",
    "opossum": "^10.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "swagger-ui-express": "^5.0.1",
    "valibot": "^1.1.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@puk/typescript-config": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  }
}
